{
  "info": {
    "_postman_id": "evently-api-collection-2026",
    "name": "Evently Full-Stack Event Booking API Collection",
    "description": "Complete REST API collection for Evently platform including Auth, OTP, Events, Bookings, Reviews, Wishlist, Q&A, and Reports.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication & OTP",
      "item": [
        {
          "name": "1. Register User (With Phone)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"phone\": \"+91 98765 43210\",\n  \"password\": \"Password123\",\n  \"role\": \"user\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "2. Verify 6-Digit OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/verify-otp", "host": ["{{baseUrl}}"], "path": ["api", "auth", "verify-otp"] }
          }
        },
        {
          "name": "3. Login Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@evently.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Events & Q&A",
      "item": [
        {
          "name": "List All Events",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/events", "host": ["{{baseUrl}}"], "path": ["api", "events"] }
          }
        },
        {
          "name": "Create Event (Organizer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{organizerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Tech Summit 2026\",\n  \"description\": \"Annual technology conference.\",\n  \"category\": \"Technology\",\n  \"date\": \"2026-11-20\",\n  \"time\": \"10:00\",\n  \"venue\": \"Tech Park\",\n  \"city\": \"Mumbai\",\n  \"ticketsTotal\": 200,\n  \"price\": 1000\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/events", "host": ["{{baseUrl}}"], "path": ["api", "events"] }
          }
        }
      ]
    },
    {
      "name": "Bookings & QR Check-in",
      "item": [
        {
          "name": "Create Booking (With VIP Seats)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"seats\": 2,\n  \"selectedSeats\": [\"A-01\", \"A-02\"],\n  \"tierName\": \"VIP\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
          }
        },
        {
          "name": "Venue Door Check-in",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{organizerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/bookings/check-in/{{bookingRef}}", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "check-in", "{{bookingRef}}"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001" }
  ]
}
